<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_controller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#B8000000"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="0:00"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            app:bar_height="3dp"
            app:played_color="@android:color/white"
            app:buffered_color="#80FFFFFF"
            app:scrubber_color="@android:color/white"
            app:unplayed_color="#55FFFFFF" />

        <TextView
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:gravity="end"
            android:text="0:00"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/lock_screen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lock_screen"
            android:src="@drawable/ic_round_lock_open_24" />

        <ImageButton
            android:id="@+id/aspect_ratio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aspect_ratio"
            android:src="@drawable/ic_round_aspect_ratio_24" />

        <ImageButton
            android:id="@+id/playback_speed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playback_speed"
            android:src="@drawable/ic_round_speed_24" />

        <ImageButton
            android:id="@+id/subtitles"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitles"
            android:src="@drawable/ic_round_subtitles_24" />

        <ImageButton
            android:id="@+id/enter_pip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/picture_in_picture"
            android:src="@drawable/ic_round_picture_in_picture_alt_24" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/rotate_screen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rotate_screen"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/exo_rew"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rewind 10 seconds"
            android:src="@android:drawable/ic_media_rew"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pause"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/exo_ffwd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward 10 seconds"
            android:src="@android:drawable/ic_media_ff"
            android:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
